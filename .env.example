# Supabase Configuration
# For frontend Vite apps, use the public URL and Publishable / Anon Key (NEVER service_role / secret key)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API Key (optional client-side override or backend key)
VITE_GEMINI_API_KEY=

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=
